# Copy to .env.cloud; chmod 600 .env.cloud. Never commit actual credentials.
APP_MODE=cloud
CLOUD_HOST=monitor.example.com
CLOUD_SCHEME=https
CLOUD_PUBLIC_URL=https://monitor.example.com
AUTH_COOKIE_SECURE=true
POSTGRES_DB=modbus_cloud
POSTGRES_USER=modbus_cloud
# Required: generate a unique random value locally; no default production password.
POSTGRES_PASSWORD=
AUTH_SESSION_HOURS=8
AUTH_LOGIN_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=900
LOG_LEVEL=INFO
# Keep false during initial read-only commissioning (also disabled on Edge).
MODBUS_WRITES_ENABLED=false
REMOTE_COMMAND_MAX_AGE_SECONDS=60
# Only Caddy publishes ports. Database/API have no host mappings.
CLOUD_BIND_ADDRESS=0.0.0.0
CLOUD_HTTP_PORT=80
CLOUD_HTTPS_PORT=443
# First ADMIN: interactive python -m app.bootstrap. No bootstrap password in env.
# No application signing secret: opaque sessions use random tokens + DB hashes.
# API=/api and WebSocket=/api/ws/live, derived from the same browser origin.
# Register machine tokens in Cloud System UI; plaintext remains only on Edge.
# Telegram stays on Edge; no Telegram token is needed by Cloud.

# Encrypted backups live in the private cloud_backups volume. Download independent copies.
BACKUP_RETENTION_COUNT=10
BACKUP_MAX_UPLOAD_MB=2048
BACKUP_MAX_EXPANDED_MB=8192
BACKUP_TIMEOUT_SECONDS=1800
CONFIGURATION_MAX_UPLOAD_MB=10
# No backup encryption passphrase in environment files.
