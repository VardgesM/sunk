# MERGE these settings into the existing local environment. Do not replace DB/RTU settings.
# APP_MODE takes precedence over legacy APPLICATION_MODE.
APP_MODE=edge
# Generate once or use the existing installation UUID from Settings/System.
EDGE_INSTALLATION_ID=
SYNC_CLOUD_URL=https://monitor.example.com/
# Random independent machine credential, at least 32 characters. Register same token on Cloud.
SYNC_TOKEN=
SYNC_ALLOW_INSECURE_HTTP=false
SYNC_INTERVAL_SECONDS=2
SYNC_BATCH_SIZE=100
# Independent bounded batches; omitted values fall back to SYNC_BATCH_SIZE.
SYNC_CURRENT_BATCH_SIZE=100
SYNC_HISTORY_BATCH_SIZE=100
SYNC_TIMEOUT_SECONDS=10
SYNC_BACKOFF_MAX_SECONDS=60
# Preserve configured real transports and database credentials; never fall back to simulation.
TELEMETRY_SOURCE=modbus
SIMULATOR_ENABLED=false
MODBUS_WRITES_ENABLED=false
# Native Windows worker/sync connect to the existing published LOCAL database.
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# Keep local POSTGRES_DB, POSTGRES_USER and POSTGRES_PASSWORD unchanged.
