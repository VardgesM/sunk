# Copy to /opt/gateway/.env (never copy the Modbus database credentials here).
MODBUS_HOST=monitor.example.com
MODBUS_SCHEME=https
GATEWAY_NETWORK=web
# Must match the trusted proxy IP in the Modbus .env.cloud and external network subnet.
GATEWAY_IPV4=172.30.50.2
GATEWAY_BIND_ADDRESS=0.0.0.0
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
MODBUS_API_UPSTREAM=modbus-api:8000
MODBUS_FRONTEND_UPSTREAM=modbus-frontend:8080
# Fill with inspected volume names; do not guess or recreate existing certificate data.
CADDY_DATA_VOLUME=
CADDY_CONFIG_VOLUME=
