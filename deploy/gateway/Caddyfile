{
    admin off
    http_port 8080
    https_port 8443
    servers {
        protocols h1 h2
    }
}

# Container health only; not published.
http://:8090 {
    respond /healthz "ok" 200
}

{$CLOUD_SITE} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy same-origin
        -Server
    }
    @api path /api /api/*
    handle @api {
        request_body {
            max_size 5MB
        }
        header Cache-Control "no-store"
        reverse_proxy {$MODBUS_API_UPSTREAM:modbus-api:8000}
    }
    handle {
        header Cache-Control "no-cache"
        reverse_proxy {$MODBUS_FRONTEND_UPSTREAM:modbus-frontend:8080}
    }
}

http:// {
    respond "Unknown host" 421
}
