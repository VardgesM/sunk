# Copy to .env and replace the placeholder. Never commit .env.
POSTGRES_DB=modbus_monitor
POSTGRES_USER=modbus_monitor
POSTGRES_PASSWORD=REPLACE_WITH_YOUR_OWN_STRONG_PASSWORD
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
API_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LOG_LEVEL=INFO
WORKER_HEARTBEAT_SECONDS=10
WORKER_CONFIG_REFRESH_SECONDS=2
# Explicit development opt-in. No real Modbus clients exist.
SIMULATOR_ENABLED=false
# Choose disabled, simulator, or modbus. Unset preserves legacy SIMULATOR_ENABLED behavior.
# TELEMETRY_SOURCE=simulator
MODBUS_BACKOFF_INITIAL_SECONDS=1
MODBUS_BACKOFF_MAX_SECONDS=30
WORKER_MAX_PARALLEL_CONNECTIONS=32
SIMULATOR_FAILURE_PROBABILITY=0
STALE_MULTIPLIER=3
STALE_CHECK_SECONDS=1
HISTORY_CLEANUP_SECONDS=3600
API_PROXY_TARGET=http://localhost:8000

# Physical control is opt-in; the worker must restart to change this switch.
MODBUS_WRITES_ENABLED=false
COMMAND_MAX_ATTEMPTS=3
COMMAND_MAX_AGE_SECONDS=60
COMMAND_RETRY_SECONDS=1

# Telegram is opt-in; destination/chat ID is managed in Alarms UI.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_TIMEOUT_SECONDS=5

# IANA timezone for Telegram display only, e.g. Asia/Yerevan. Database stays UTC.
TELEGRAM_TIMEZONE=UTC
